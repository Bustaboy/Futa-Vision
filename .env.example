# Futa-Vision environment template.
# Copy this file to `.env` and fill in local paths/secrets. Do not commit `.env`.

# ---- RunPod cloud offload ----
RUNPOD_API_KEY=replace_with_your_runpod_api_key
RUNPOD_ENDPOINT_ID=
RUNPOD_TEMPLATE_ID=
RUNPOD_NETWORK_VOLUME_ID=
RUNPOD_DEFAULT_GPU=NVIDIA RTX 4090
RUNPOD_STOP_AFTER_JOB=true

# ---- Local AI engine paths ----
# Leave blank to let setup.py search common Pinokio, portable, and home-directory locations.
OSTRIS_PATH=
COMFYUI_PATH=
PINOKIO_HOME=
OSTRIS_GIT_REF=main
COMFYUI_VERSION=v0.22.0
FUTA_VISION_INSTALL_TIER=minimal
FUTA_VISION_SKIP_MODELS=false

# ---- Hugging Face gated model access ----
# Preferred storage is the OS keyring through the installer. Use these only as a fallback.
HF_TOKEN=
HF_API_TOKEN=

# ---- Futa-Vision storage roots ----
FUTA_VISION_LIBRARY_DIR=./library
FUTA_VISION_DATASETS_DIR=./datasets
FUTA_VISION_OUTPUTS_DIR=./outputs
FUTA_VISION_WORKFLOWS_DIR=./workflows
FUTA_VISION_CACHE_DIR=./cache
FUTA_VISION_LOGS_DIR=./logs

# ---- ComfyUI connection ----
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
COMFYUI_API_BASE=http://127.0.0.1:8188

# ---- Low-VRAM defaults for RTX 4070 8 GB ----
FUTA_VISION_DEFAULT_MODE=local_low_vram
FUTA_VISION_DEFAULT_WIDTH=1280
FUTA_VISION_DEFAULT_HEIGHT=720
FUTA_VISION_DEFAULT_BATCH_SIZE=1
FUTA_VISION_ENABLE_DISK_CACHE=true
FUTA_VISION_ENABLE_FP8=true
FUTA_VISION_OOM_FALLBACK_TO_RUNPOD=true

# ---- Model/workflow profile defaults ----
FUTA_VISION_BASE_MODEL_PROFILE=z-image-turbo-nsfw
FUTA_VISION_FALLBACK_MODEL_PROFILE=pony-diffusion-v7
FUTA_VISION_VIDEO_PIPELINE=ltx-2.3-preview
FUTA_VISION_FINAL_PIPELINE=wan-2.7-physics
FUTA_VISION_UPSCALER=seedvr-2.5

# ---- Safety and privacy ----
FUTA_VISION_LOCAL_ONLY_DEFAULT=true
FUTA_VISION_REQUIRE_ADULT_CONFIRMATION=true
FUTA_VISION_REDACT_LOGS=true

# Next step: after editing this file, run `python main.py` and open the Setup tab to validate paths.
