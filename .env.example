# Futa-Vision environment template.
# Copy this file to .env and customize local paths/secrets. Do not commit .env.

# -----------------------------
# App mode and safety defaults
# -----------------------------
FUTA_VISION_EXECUTION_MODE=local_low_vram
FUTA_VISION_DEFAULT_RESOLUTION=1280x720
FUTA_VISION_SCORE_THRESHOLD=80
FUTA_VISION_LOCAL_ONLY_DEFAULT=true
FUTA_VISION_REQUIRE_CLOUD_CONFIRMATION=true

# -----------------------------
# RunPod cloud offload settings
# -----------------------------
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_TEMPLATE_ID=
RUNPOD_GPU_TYPE=NVIDIA GeForce RTX 4090
RUNPOD_STOP_AFTER_JOB=true

# -----------------------------
# Local app storage paths
# -----------------------------
FUTA_VISION_LIBRARY_DIR=./library
FUTA_VISION_DATASETS_DIR=./datasets
FUTA_VISION_OUTPUTS_DIR=./outputs
FUTA_VISION_WORKFLOWS_DIR=./workflows
FUTA_VISION_LOGS_DIR=./logs
FUTA_VISION_CACHE_DIR=./cache
FUTA_VISION_GENERAL_PHYSICS_LORA_DIR=./general_physics_lora

# -----------------------------
# Existing Pinokio / app install paths
# Leave blank to let setup.py auto-detect common Pinokio locations.
# -----------------------------
PINOKIO_HOME=
COMFYUI_PATH=
OSTRIS_AI_TOOLKIT_PATH=
COMFYUI_BASE_URL=http://127.0.0.1:8188

# -----------------------------
# Optional model/profile folders
# -----------------------------
MODEL_ROOT_DIR=./models
COMFYUI_MODEL_DIR=
Z_IMAGE_MODEL_DIR=
PONY_MODEL_DIR=
WAN_WORKFLOW_DIR=./workflows/comfy/wan
LTX_WORKFLOW_DIR=./workflows/comfy/ltx
UPSCALE_WORKFLOW_DIR=./workflows/comfy/upscale

# -----------------------------
# Optional LLM routing for chat edits
# -----------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Next step: copy to .env, add only local absolute paths/API keys, then run `python setup.py --check`.
